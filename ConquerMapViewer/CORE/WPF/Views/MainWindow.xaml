<Window x:Class="ConquerMapViewer.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ConquerMapViewer.WPF.Controls"
        Title="Conquer Map Viewer" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <ToolBar>
                <Button Content="🏠 Reset" Command="{Binding ResetViewCommand}" 
                        ToolTip="Reset view to default (Home key)"/>
                <Button Content="⊞ Fit" Command="{Binding FitToWindowCommand}"
                        ToolTip="Fit map to window (F key)"/>
                <Separator/>
                <Button Content="➕" Command="{Binding ZoomInCommand}" Width="30"
                        ToolTip="Zoom in (+/= key)"/>
                <TextBlock Text="{Binding ZoomPercentage}" VerticalAlignment="Center" 
                           Width="50" TextAlignment="Center" FontWeight="Bold"/>
                <Button Content="➖" Command="{Binding ZoomOutCommand}" Width="30"
                        ToolTip="Zoom out (- key)"/>
                <Separator/>
                <Button Content="📍 Jump" Command="{Binding JumpToCoordinateCommand}"
                        ToolTip="Jump to coordinate"/>
                <Separator/>
                <Button Content="📷 Export" Command="{Binding ExportScreenshotCommand}"
                        ToolTip="Export screenshot"/>
                <Separator/>
                <Button Content="⚙️ Settings" Command="{Binding ChangeConquerDirectoryCommand}"
                        ToolTip="Change Conquer directory"/>
                <Separator/>
                <TextBlock Text="FPS:" VerticalAlignment="Center" Margin="5,0"/>
                <TextBlock Text="{Binding FPS}" VerticalAlignment="Center" Width="30" FontWeight="Bold"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0"
                Background="#F5F5F5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <!-- Map Search -->
                    <TextBlock Text="Map Browser" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,5">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="🔍 Search maps..." 
                                                                   Foreground="Gray" Margin="5,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Map List -->
                    <ListBox ItemsSource="{Binding FilteredMaps}"
                             SelectedItem="{Binding SelectedMap}"
                             Height="250"
                             Margin="0,0,0,5"
                             MouseDoubleClick="MapList_MouseDoubleClick"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                    <TextBlock FontSize="10" Foreground="Gray">
                                        <Run Text="ID:"/>
                                        <Run Text="{Binding Id}"/>
                                        <Run Text=" | Tile:"/>
                                        <Run Text="{Binding TileSize}"/>
                                        <Run Text="px"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="Load Selected Map" 
                            Command="{Binding LoadMapCommand}"
                            CommandParameter="{Binding SelectedMap}"
                            Padding="5"
                            Margin="0,0,0,10"/>

                    <!-- Loading Indicator -->
                    <ProgressBar IsIndeterminate="True" 
                                 Height="3"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                 Margin="0,0,0,10"/>

                    <Separator Margin="0,5"/>

                    <!-- Layer Controls -->
                    <TextBlock Text="Layers" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
                    <ItemsControl ItemsSource="{Binding Layers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled}" 
                                          Content="{Binding Name}"
                                          Margin="0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,10"/>

                    <!-- Controls Help -->
                    <TextBlock Text="Controls" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666">
                        <Run Text="🖱️ Right-click + drag: Pan"/>
                        <LineBreak/>
                        <Run Text="🖱️ Scroll wheel: Zoom"/>
                        <LineBreak/>
                        <Run Text="⌨️ WASD / Arrows: Pan"/>
                        <LineBreak/>
                        <Run Text="⌨️ Shift + movement: Fast pan"/>
                        <LineBreak/>
                        <Run Text="⌨️ +/-: Zoom in/out"/>
                        <LineBreak/>
                        <Run Text="⌨️ Home/H: Reset view"/>
                        <LineBreak/>
                        <Run Text="⌨️ F: Fit to window"/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Map Viewer -->
        <controls:MapViewerControl x:Name="GameControl" 
                                   Grid.Row="1" 
                                   Grid.Column="1"/>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
